<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/homepage_bg"
    tools:context=".HomeFragment">

    <!-- App Title -->
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:fontFamily="sans-serif-condensed"
        android:shadowColor="#66000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="6"
        android:text="LanguaPlay"
        android:textColor="@android:color/white"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- High Score Section -->
    <LinearLayout
        android:id="@+id/scoreSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/highscore_card_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:elevation="15dp"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/quizScoreTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Quiz High Score: 110"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/fillBlanksScoreTextview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fill in the Blanks High Score: 0"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- Game Selection Layout -->
    <LinearLayout
        android:id="@+id/gameSelectionLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/scoreSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Flashcards Button -->
        <Button
            android:id="@+id/btnFlashcards"
            android:layout_width="250dp"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/rounded_button"
            android:text="Flashcards"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <!-- Quiz Button -->
        <Button
            android:id="@+id/btnQuiz"
            android:layout_width="250dp"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/rounded_button"
            android:text="Quiz"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <!-- Fill in the Blanks Button -->
        <Button
            android:id="@+id/btnFillBlanks"
            android:layout_width="250dp"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/rounded_button"
            android:text="Fill in the Blanks"
            android:textColor="@android:color/white"
            android:textSize="16sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
